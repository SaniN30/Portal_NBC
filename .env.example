# Copy to .env and fill. Never commit .env.

# Postgres (Neon pooled connection string — see IdeaV2.md §11)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Session signing (openssl rand -base64 32)
JWT_SECRET=""

# Vercel Blob (private resume storage)
BLOB_READ_WRITE_TOKEN=""

# Email OTP — Resend
RESEND_API_KEY=""
OTP_FROM_EMAIL="noreply@neevbridge.example"

# Phone OTP — Twilio (Messages API). Leave unset to keep phone login disabled.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Show the phone option in the login UI. Set to "1" once Twilio above is configured.
NEXT_PUBLIC_PHONE_LOGIN_ENABLED=""

# Seed
SEED_ADMIN_EMAIL="admin@neevbridge.example"
